# Local development only. Do not commit real secrets.
NARATRACE_HOST=127.0.0.1
NARATRACE_PORT=8765
NARATRACE_MOCK_MODE=false
NARATRACE_A3340_INDEX_CONCURRENCY=16

# Development fallback only. Preferred storage is the OS keyring.
