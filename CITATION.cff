    affiliation: "Friedrich-Schiller-Universität Jena"
version: 1.0.0
date-released: 2026-11-26
repository-code: "https://github.com/Datenflix007/NARA-Trace"
keywords:
  - National Archives and Records Administration
  - NARA
  - Digital History
  - Quellenkritik
  - Personenrecherche
  - OCR
